<Window x:Class="RvtGo.Forms.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RvtGo — Launch options"
        Width="740" Height="820" MinWidth="640" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F6F7F8"
        FontFamily="Segoe UI" FontSize="13" Foreground="#1B1F24"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#0E7490"/>
        <SolidColorBrush x:Key="Muted" Color="#4B5560"/>
        <SolidColorBrush x:Key="CardBorder" Color="#DADDE1"/>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="MonoBox" TargetType="TextBox">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="BorderBrush" Value="#B7BDC4"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#B7BDC4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="24,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="ButtonCancel" Content="Cancel" Style="{StaticResource SecondaryButton}" IsCancel="True" Margin="0,0,10,0" Click="ButtonCancel_Click"/>
                    <Button x:Name="ButtonLaunch" Content="Launch RvtGo" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="ButtonLaunch_Click"/>
                </StackPanel>
                <TextBlock x:Name="TextEstimate" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Muted}" Text="Est. 0 elements"/>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,20,24,20">

                <!-- Start position -->
                <Border Background="#E6F4F7" BorderBrush="#A8D8E2" BorderThickness="1" Padding="12,10" Margin="0,0,0,18">
                    <TextBlock TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Text="Start position: "/>
                        <Run x:Name="RunSpawn" Text="—"/>
                    </TextBlock>
                </Border>

                <!-- Categories -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="CATEGORIES TO LOAD"/>
                <UniformGrid x:Name="GridGroups" Columns="3" Margin="-5,0,-5,0"/>
                <CheckBox x:Name="CheckHeavy" Margin="0,10,0,18" Content="Include ducts, pipes, cable trays and conduits (heavy)" Checked="AnyCategory_Changed" Unchecked="AnyCategory_Changed"/>

                <!-- Geometry -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="GEOMETRY"/>
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="38"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Triangle limit per element"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox x:Name="TextThreshold" Style="{StaticResource MonoBox}"/>
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Muted}" Text="FFE &amp; Services only"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Over the limit"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton x:Name="RadioProxy" GroupName="OverLimit" Content="Bounding-box proxy" Margin="0,0,16,0"/>
                        <RadioButton x:Name="RadioSkip" GroupName="OverLimit" Content="Skip"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Colour"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton x:Name="RadioWhitecard" GroupName="Colour" Content="Whitecard" Margin="0,0,16,0"/>
                        <RadioButton x:Name="RadioMaterial" GroupName="Colour" Content="Material colours"/>
                    </StackPanel>

                    <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="Max step height (stairs)"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox x:Name="TextStep" Style="{StaticResource MonoBox}"/>
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Muted}" Text="mm"/>
                    </StackPanel>
                </Grid>

                <!-- Player & display -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="PLAYER &amp; DISPLAY"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="34"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Anti-aliasing"/>
                    <ComboBox x:Name="ComboMsaa" Grid.Row="0" Grid.Column="1" Width="140" Height="28" HorizontalAlignment="Left" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="Off"/>
                        <ComboBoxItem Content="MSAA 2x"/>
                        <ComboBoxItem Content="MSAA 4x"/>
                    </ComboBox>

                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Field of view"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Slider x:Name="SliderFov" Width="200" Minimum="60" Maximum="120" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged"/>
                        <TextBlock x:Name="TextFov" Margin="10,0,0,0" FontFamily="Consolas" VerticalAlignment="Center" Text="90°"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Mouse sensitivity"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Slider x:Name="SliderSensitivity" Width="200" Minimum="0.1" Maximum="3" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged"/>
                        <TextBlock x:Name="TextSensitivity" Margin="10,0,0,0" FontFamily="Consolas" VerticalAlignment="Center" Text="1.00"/>
                    </StackPanel>

                    <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="Options"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="CheckInvertY" Content="Invert Y" Margin="0,0,16,0"/>
                        <CheckBox x:Name="CheckVSync" Content="VSync" Margin="0,0,16,0"/>
                        <CheckBox x:Name="CheckComments" Content="Load comments"/>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
